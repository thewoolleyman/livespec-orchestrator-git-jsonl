// Project-local livespec configuration for livespec-orchestrator-git-jsonl.
// This plugin dogfoods livespec: the SPECIFICATION/ tree at the repo
// root is the live spec. As of epic li-ws2iv4 (Phase 5 cutover), this
// repo's OWN impl tracking lives in the per-repo livespec-orchestrator-beads-fabro
// Dolt tenant; the legacy plaintext work-items JSONL ledger was
// frozen under archive/.
//
// Authority: livespec/SPECIFICATION/contracts.md
//   §"Cross-repo coordination — pin-and-bump"
//   §"`compat` block" (the schema this file populates)
{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  // Dispatcher/Fabro implementation commits use the operator identity below.
  // Mechanical authors are limited to the GitHub Apps proven by this repo's
  // release and dependency-pin automation/history.
  "git_author": {
    "operator_name": "Chad Woolley",
    "operator_email": "thewoolleyman@gmail.com",
    "mechanical_authors": [
      { "name": "livespec-pr-bot[bot]", "email": "livespec-pr-bot[bot]@users.noreply.github.com" },
      { "name": "livespec-pr-bot[bot]", "email": "283469463+livespec-pr-bot[bot]@users.noreply.github.com" },
      { "name": "thewoolleyman-factory-bot[bot]", "email": "thewoolleyman-factory-bot[bot]@users.noreply.github.com" },
      { "name": "thewoolleyman-factory-bot[bot]", "email": "283469463+thewoolleyman-factory-bot[bot]@users.noreply.github.com" }
    ]
  },
  // Foreman human-valve disposition. Opts this repo's foreman seat into the
  // CONSENSUS tier: a human valve or blocked session may be disposed by a
  // unanimous review panel through foreman-act, instead of being surfaced
  // report-only and left to sit. Enabled 2026-08-21 at the maintainer's
  // explicit fleet-wide direction. The resolver's fail-closed default is
  // "report-only", so an UNSET repo silently surfaces valves and never acts
  // on them -- which is what this key exists to prevent. The contract floors
  // are NOT relaxed: dissent, insufficient information, hard-risk, and
  // human-gated-by-design decisions still escalate regardless of any panel
  // verdict.
  "livespec-overseer": { "foreman_valve_disposition": "consensus" },
  "template": "livespec",
  "spec_root": "SPECIFICATION",
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  "cross_repo_targets": {
    "livespec-dev-tooling": {
      "github_url": "https://github.com/thewoolleyman/livespec-dev-tooling",
      "local_clone": "/data/projects/livespec-dev-tooling",
      "default_branch": "master"
    },
    "livespec": {
      "github_url": "https://github.com/thewoolleyman/livespec",
      "local_clone": "/data/projects/livespec",
      "default_branch": "master"
    }
  },
  // Fleet-default credential-injection wrapper (argv-form command prefix) for
  // this repo's OWN work-item tracking. The livespec-orchestrator-beads-fabro
  // impl-plugin CLIs (see "implementation" above) run against this repo's Dolt
  // tenant and re-exec through this prefix when BEADS_DOLT_PASSWORD is absent,
  // so the 1Password Environment wrapper injects the shared fleet tenant secret
  // before any beads CLI runs. The git-jsonl plugin's OWN shipped CLIs read a
  // local JSONL store and need no injected secret, so they do NOT consume this
  // key. Backend-agnostic per livespec core's config schema (a non-empty array
  // of strings); the secret backend + injected vars are this project's own
  // concern and are NEVER committed here.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  "harnesses": {
    "claude": { "status": "supported", "canonical_command": "livespec-orchestrator-git-jsonl:next" },
    "codex":  { "status": "supported", "canonical_command": "livespec-orchestrator-git-jsonl:next" }
  },
  // ACTIVE spec-governance overrides for this repo. Only the keys listed here
  // depart from the shipped defaults; every other lever (doctor_dispositions,
  // drift_acceptance_mode, ratification_reviewer_model,
  // ratification_min_review_age_seconds) stays at the default documented in
  // the reference block below.
  //   propose_change_mode: "batch" — arms non-interactive
  //   /livespec:propose-change (maintainer-directed fleet-wide autonomy lever).
  //   critique_mode: "batch" — arms non-interactive /livespec:critique.
  //   in_flight_alignment: "default-align" — resolves in-flight-proposal
  //   conflicts without prompting.
  //   revise_decision_mode: "delegated" — non-drift proposals ratify without a
  //   manual /livespec:revise prompt (root-cause fix for livespec-jvdvx4.15:
  //   this lever shipped in livespec core but was never armed anywhere in the
  //   fleet, so revise gates stayed manual by default everywhere).
  //   ratification_review: "auto-spawn" — the independent adversarial review
  //   is spawned automatically rather than waiting on a manual trigger.
  //   ratification_reviewer_model: ["opus", "gpt-6-astra"] — an ordered list.
  //   Opus is the primary ratification reviewer and auto-spawn selects it;
  //   gpt-6-astra (Codex) is the fallback, and a review by EITHER model
  //   ratifies. The models are interchangeable like any other model selection
  //   here. "auto-spawn" above is inert when this key is null.
  //   spec_pr_merge: "auto-on-green" — a ratifying spec PR merges once its
  //   required checks are green, with no manual merge click.
  // Maintainer-directed fleet-wide autonomy lever rollout, epic livespec-jvdvx4
  // (livespec-jvdvx4.15), 2026-08-16.
  // Cross-repository citations the spec may make (doctor-no-cross-spec-reference).
  // constraints.md §"Delegated pre-push gate" cites livespec-dev-tooling's
  // §"Delegated pre-push gate" and livespec's §"Enforcement-suite invocation".
  // BARE heading form: a file-qualified entry is validated against a local
  // sibling clone that CI runners do not have.
  "external_references": {
    "livespec-dev-tooling": ["§\"Delegated pre-push gate\""],
    "livespec": ["§\"Enforcement-suite invocation\""]
  },
  "spec_governance": {
    "propose_change_mode": "batch",
    "critique_mode": "batch",
    "in_flight_alignment": "default-align",
    "revise_decision_mode": "delegated",
    "ratification_review": "auto-spawn",
    "ratification_reviewer_model": ["sonnet"],
    "spec_pr_merge": "auto-on-green"
  },
  // Optional — spec_governance: policy levers for livespec's spec-side
  // operations. The commented defaults below are derived from the shipped
  // spec-governance manifest; leaving a key out of the active block above
  // keeps it at the default shown here.
  // To enable any key, add it to the active block above and keep only the
  // entries this repo intentionally overrides:
  //   "spec_governance": {
  //     // propose_change_mode (enum; allowed: "interactive", "batch")
  //     "propose_change_mode": "interactive",
  //     // critique_mode (enum; allowed: "interactive", "batch")
  //     "critique_mode": "interactive",
  //     // in_flight_alignment (enum; allowed: "prompt", "default-align")
  //     "in_flight_alignment": "prompt",
  //     // doctor_dispositions (map; allowed values: "fix-now",
  //     // "capture-as-work-item", "propose-change", "defer", "dismiss")
  //     "doctor_dispositions": {},
  //     // revise_decision_mode (enum; allowed: "manual", "delegated",
  //     // "consensus"; per-proposal override: decision_policy)
  //     "revise_decision_mode": "manual",
  //     // drift_acceptance_mode (enum; allowed: "human", "consensus")
  //     "drift_acceptance_mode": "human",
  //     // ratification_review (enum; allowed: "manual-spawn", "auto-spawn";
  //     // per-proposal override: ratification_review_policy)
  //     "ratification_review": "manual-spawn",
  //     // ratification_reviewer_model (string; no enumerated allowed values)
  //     "ratification_reviewer_model": null,
  //     // ratification_min_review_age_seconds (integer; minimum: 1)
  //     "ratification_min_review_age_seconds": 1,
  //     // spec_pr_merge (enum; allowed: "manual", "auto-on-green";
  //     // per-proposal override: spec_pr_merge_policy)
  //     "spec_pr_merge": "manual"
  //   }
  //
  "livespec-orchestrator-beads-fabro": {
    "format": "beads",
    "compat": { "livespec": ">=0.1.0,<1.0.0", "pinned": "v0.44.2" },
    // Per-repo beads tenant CONNECTION block. tenant==database==server_user is the
    // load-bearing tenant identity (one Dolt name serves all three). The issue-ID
    // `prefix` is bd's short server-stored create-prefix (`bd-gj`), DECOUPLED from
    // the DB name. Tenant PASSWORD deliberately ABSENT — supplied only via the
    // BEADS_DOLT_PASSWORD env var at bd-call time, never committed. TCP-only, so no `socket` key.
    "connection": {
      "tenant": "livespec-orchestrator-git-jsonl",
      "prefix": "bd-gj",
      "database": "livespec-orchestrator-git-jsonl",
      "server_user": "livespec-orchestrator-git-jsonl",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Autonomous-mode levers (maintainer-directed 2026-07-20). Two of the three
    // policy settings in livespec/SPECIFICATION/contracts.md §"The three policy
    // settings" are moved off their safe defaults so ready work is ADMITTED and
    // ACCEPTED without a human valve:
    //   auto_approve_ready: true      — pending-approval → ready with no human.
    //   acceptance_mode: "ai-only"    — post-merge acceptance without a human.
    // The third lever, `merge_on_review_cap`, deliberately STAYS at its safe
    // `false` default and is NOT listed here: a review that cannot converge
    // within `review_fix_cap` rounds is precisely the case that must reach a
    // human, per the design record cited in that section. A design-human-gated
    // (spec-change-tier) item still cannot auto-approve regardless of these.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      // CODEX-FIRST on every node (maintainer direction 2026-10-25: the factory runs OpenAI
      // models by default with Anthropic minimized; fleet-wide ruling by coordinator
      // gitops-fleet-capacity-monitoring). codex-acp is each node's primary and claude-acp
      // its fallback, used only when Codex hits its limit. Same block as
      // livespec-orchestrator-beads-fabro a03cbeb0. Only gpt-5.6-terra and gpt-5.6-luna,
      // the slugs proven reachable on the factory's ChatGPT account.
      "acp_nodes": {
        "dod_gate": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "high" },
        // 2026-10-30: implement, fix and review on Codex Terra with a Sonnet fallback (maintainer
        // direction via the coordinator, superseding R153 for these three nodes); the Codex
        // headroom brake skips to the fallback before the weekly window is spent.
        "implement": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "high" }] },
        "fix": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "high" }] },
        "review_fix": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "high" },
        "proof_capture": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" },
        "proof_verify": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" },
        "review": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "high" }] },
        "pr": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" },
        "disposition": { "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" }
      },
      "model_catalog": {
        "anthropic/claude-sonnet-5-5": {
          "display_name": "Claude Sonnet 5.5",
          "pricing": {
            "model": "claude-sonnet-5-5",
            "input_usd_per_million": 2.0,
            "output_usd_per_million": 10.0,
            "cache_write_usd_per_million": 2.5,
            "cache_read_usd_per_million": 0.2
          }
        }
      },
      // Sandbox toolchain + conformance premises. Every prepare step is a
      // PROJECTION of this repository's own declaration, and an undeclared
      // premise is the ratified explicit NO-OP. With nothing declared here,
      // the registry-switch dispatch of bd-gj-2kt36v (fabro run
      // 01M5E8WB8SBT131P7VMK1GH2NW on hp, 2026-10-21) died in setup after
      // 4 s: `mise trust` never ran, so the mise-managed
      // `uv sync --all-groups` refused the untrusted .mise.toml. A run that
      // got past setup would also have installed no commit-refuse hook.
      // Values mirror livespec-runtime's block (itself mirroring
      // livespec-dev-tooling's, the schema author's own); this repository's
      // dev group installs livespec-dev-tooling, and `uv sync --all-groups`
      // runs immediately before the conformance trio.
      "prepare_toolchain": {
        "mise": ["sh", "-c", "mise trust && env -u GITHUB_TOKEN -u GH_TOKEN -u GITHUB_API_TOKEN mise install --quiet"],
        "lefthook": ["uv", "run", "lefthook", "install"]
      },
      "conformance": {
        "hook_install": { "mode": "internal_livespec_dev_tooling" },
        "verify_commit_refuse_hook": { "mode": "internal_livespec_dev_tooling" },
        "verify_plugin_resolution": { "mode": "internal_livespec_dev_tooling" }
      },
      // Committed MIRROR of the capability set the sandbox image this
      // repository's dispatches run on publishes at
      // /etc/livespec/sandbox-capabilities. The published file is the
      // authority and the `dod_gate` node reads it from inside the sandbox;
      // this array exists for the surfaces that have no sandbox to reach
      // into — the filing and approve displays, and the control host's
      // dod-preflight, which REFUSES outright while the key is absent
      // ("the governed repository commits no dispatcher.sandbox_capabilities,
      // so this host cannot run the gate's capability check (check 5)").
      //
      // MEASURED, never guessed (coordinator ruling R347 rejected a guessed
      // mirror; the orchestrator repository's own block describes ITS
      // sandbox). Probed 2026-10-21 inside the sandbox of this repository's
      // own dispatch of bd-gj-mluwnm (Ubuntu 24.04.5 LTS). The image
      // published exactly these four names, in this order
      // (/etc/livespec/sandbox-capabilities,
      // sha256:1ef30541cca41ebc02893e18634080b6f11937b89de1b2ca763f194b4acbf36f),
      // and each was EXERCISED rather than merely looked up: terminal =
      // GNU bash 5.2.21 at /usr/bin/bash; tmux = /usr/bin/tmux 3.4, which
      // created and listed a detached session; headless_browser =
      // Playwright 1.63.0 driving Chromium 153.0.8010.12, which rendered a
      // page to a PNG; herdr = /usr/local/bin/herdr 0.9.3, which printed
      // its usage. tests/test_sandbox_capabilities_mirror.py holds this
      // array to that measurement.
      "sandbox_capabilities": ["terminal", "tmux", "headless_browser", "herdr"],
      "auto_approve_ready": true,
      "wip_cap": 10,
      "acceptance_mode": "ai-only",
      // Registry-backed factory table. Per SPECIFICATION/constraints.md
      // section "Factory routing" (ratified at v019), no entry committed
      // here names a machine: each declares "registry": true and carries
      // neither a server nor a docker_host value. Which Fabro server
      // answers to a factory name is bound ONLY in the fleet gitops
      // inventory's factory registry, which each dispatching host renders
      // and a dispatch resolves by name.
      //
      // `legacy` replaces the two hostname-bearing entries this repository
      // used to commit — `hp` (the former default) and the retired `vps`.
      // The registry maps `legacy` to the same instance `hp` named, so
      // routing is unchanged, and a recorded item pin naming `hp`, `vps`
      // or `default` falls back to `default_factory` under the ratified
      // recorded-pin fallback. `legacy`, the hp-xubuntu instance's registry
      // name, was retired and removed from this table on 2026-10-24 (plan
      // fabro-currency), and a pin naming it falls back the same way.
      "factories": {
        // The current Fabro server, selected by default since the R668 cutover
        // (plan petri-factory-on-gmktec); resolved through the factory registry.
        "petri": {
          "registry": true,
          "bin": "/home/ubuntu/.local/state/fabro-currency/carrier-petri-v0.382-adeefec4c/fabro",
          "secret_channel": "native_secrets",
          // factory-python: the toolchain-named catalog id (livespec-dev-tooling
          // SPECIFICATION, "Factory sandbox environment naming"). Its provider, not
          // this id, says where the sandbox runs, so a provider move changes nothing here.
          "environment": "factory-python"
        }
      },
      "default_factory": "petri"
    }
  }
}
