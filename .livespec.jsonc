// Project-local livespec configuration for livespec-orchestrator-git-jsonl.
// This plugin dogfoods livespec: the SPECIFICATION/ tree at the repo
// root is the live spec. As of epic li-ws2iv4 (Phase 5 cutover), this
// repo's OWN impl tracking lives in the per-repo livespec-orchestrator-beads-fabro
// Dolt tenant; the legacy plaintext work-items JSONL ledger was
// frozen under archive/.
//
// Authority: livespec/SPECIFICATION/contracts.md
//   §"Cross-repo coordination — pin-and-bump"
//   §"`compat` block" (the schema this file populates)
{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  // Foreman human-valve disposition. Opts this repo's foreman seat into the
  // CONSENSUS tier: a human valve or blocked session may be disposed by a
  // unanimous review panel through foreman-act, instead of being surfaced
  // report-only and left to sit. Enabled 2026-08-21 at the maintainer's
  // explicit fleet-wide direction. The resolver's fail-closed default is
  // "report-only", so an UNSET repo silently surfaces valves and never acts
  // on them -- which is what this key exists to prevent. The contract floors
  // are NOT relaxed: dissent, insufficient information, hard-risk, and
  // human-gated-by-design decisions still escalate regardless of any panel
  // verdict.
  "livespec-overseer": { "foreman_valve_disposition": "consensus" },
  "template": "livespec",
  "spec_root": "SPECIFICATION",
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  "cross_repo_targets": {
    "livespec-dev-tooling": {
      "github_url": "https://github.com/thewoolleyman/livespec-dev-tooling",
      "local_clone": "/data/projects/livespec-dev-tooling",
      "default_branch": "master"
    },
    "livespec": {
      "github_url": "https://github.com/thewoolleyman/livespec",
      "local_clone": "/data/projects/livespec",
      "default_branch": "master"
    }
  },
  // Fleet-default credential-injection wrapper (argv-form command prefix) for
  // this repo's OWN work-item tracking. The livespec-orchestrator-beads-fabro
  // impl-plugin CLIs (see "implementation" above) run against this repo's Dolt
  // tenant and re-exec through this prefix when BEADS_DOLT_PASSWORD is absent,
  // so the 1Password Environment wrapper injects the shared fleet tenant secret
  // before any beads CLI runs. The git-jsonl plugin's OWN shipped CLIs read a
  // local JSONL store and need no injected secret, so they do NOT consume this
  // key. Backend-agnostic per livespec core's config schema (a non-empty array
  // of strings); the secret backend + injected vars are this project's own
  // concern and are NEVER committed here.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  "harnesses": {
    "claude": { "status": "supported", "canonical_command": "livespec-orchestrator-git-jsonl:next" },
    "codex":  { "status": "supported", "canonical_command": "livespec-orchestrator-git-jsonl:next" }
  },
  // ACTIVE spec-governance overrides for this repo. Only the keys listed here
  // depart from the shipped defaults; every other lever (doctor_dispositions,
  // drift_acceptance_mode, ratification_reviewer_model,
  // ratification_min_review_age_seconds) stays at the default documented in
  // the reference block below.
  //   propose_change_mode: "batch" — arms non-interactive
  //   /livespec:propose-change (maintainer-directed fleet-wide autonomy lever).
  //   critique_mode: "batch" — arms non-interactive /livespec:critique.
  //   in_flight_alignment: "default-align" — resolves in-flight-proposal
  //   conflicts without prompting.
  //   revise_decision_mode: "delegated" — non-drift proposals ratify without a
  //   manual /livespec:revise prompt (root-cause fix for livespec-jvdvx4.15:
  //   this lever shipped in livespec core but was never armed anywhere in the
  //   fleet, so revise gates stayed manual by default everywhere).
  //   ratification_review: "auto-spawn" — the independent adversarial review
  //   is spawned automatically rather than waiting on a manual trigger.
  //   ratification_reviewer_model: "fable" — the reviewer model that auto-spawn
  //   uses. REQUIRED for auto-spawn to function: livespec core's
  //   effective_ratification_review falls back to the manual path whenever this
  //   key is unset, so arming the lever alone leaves it inert.
  //   spec_pr_merge: "auto-on-green" — a ratifying spec PR merges once its
  //   required checks are green, with no manual merge click.
  // Maintainer-directed fleet-wide autonomy lever rollout, epic livespec-jvdvx4
  // (livespec-jvdvx4.15), 2026-08-16.
  "spec_governance": {
    "propose_change_mode": "batch",
    "critique_mode": "batch",
    "in_flight_alignment": "default-align",
    "revise_decision_mode": "delegated",
    "ratification_review": "auto-spawn",
    "ratification_reviewer_model": "fable",
    "spec_pr_merge": "auto-on-green"
  },
  // Optional — spec_governance: policy levers for livespec's spec-side
  // operations. The commented defaults below are derived from the shipped
  // spec-governance manifest; leaving a key out of the active block above
  // keeps it at the default shown here.
  // To enable any key, add it to the active block above and keep only the
  // entries this repo intentionally overrides:
  //   "spec_governance": {
  //     // propose_change_mode (enum; allowed: "interactive", "batch")
  //     "propose_change_mode": "interactive",
  //     // critique_mode (enum; allowed: "interactive", "batch")
  //     "critique_mode": "interactive",
  //     // in_flight_alignment (enum; allowed: "prompt", "default-align")
  //     "in_flight_alignment": "prompt",
  //     // doctor_dispositions (map; allowed values: "fix-now",
  //     // "capture-as-work-item", "propose-change", "defer", "dismiss")
  //     "doctor_dispositions": {},
  //     // revise_decision_mode (enum; allowed: "manual", "delegated",
  //     // "consensus"; per-proposal override: decision_policy)
  //     "revise_decision_mode": "manual",
  //     // drift_acceptance_mode (enum; allowed: "human", "consensus")
  //     "drift_acceptance_mode": "human",
  //     // ratification_review (enum; allowed: "manual-spawn", "auto-spawn";
  //     // per-proposal override: ratification_review_policy)
  //     "ratification_review": "manual-spawn",
  //     // ratification_reviewer_model (string; no enumerated allowed values)
  //     "ratification_reviewer_model": null,
  //     // ratification_min_review_age_seconds (integer; minimum: 1)
  //     "ratification_min_review_age_seconds": 1,
  //     // spec_pr_merge (enum; allowed: "manual", "auto-on-green";
  //     // per-proposal override: spec_pr_merge_policy)
  //     "spec_pr_merge": "manual"
  //   }
  //
  "livespec-orchestrator-beads-fabro": {
    "format": "beads",
    "compat": { "livespec": ">=0.1.0,<1.0.0", "pinned": "v0.38.0" },
    // Per-repo beads tenant CONNECTION block. tenant==database==server_user is the
    // load-bearing tenant identity (one Dolt name serves all three). The issue-ID
    // `prefix` is bd's short server-stored create-prefix (`bd-gj`), DECOUPLED from
    // the DB name. Tenant PASSWORD deliberately ABSENT — supplied only via the
    // BEADS_DOLT_PASSWORD env var at bd-call time, never committed. TCP-only, so no `socket` key.
    "connection": {
      "tenant": "livespec-orchestrator-git-jsonl",
      "prefix": "bd-gj",
      "database": "livespec-orchestrator-git-jsonl",
      "server_user": "livespec-orchestrator-git-jsonl",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Autonomous-mode levers (maintainer-directed 2026-07-20). Two of the three
    // policy settings in livespec/SPECIFICATION/contracts.md §"The three policy
    // settings" are moved off their safe defaults so ready work is ADMITTED and
    // ACCEPTED without a human valve:
    //   auto_approve_ready: true      — pending-approval → ready with no human.
    //   acceptance_mode: "ai-only"    — post-merge acceptance without a human.
    // The third lever, `merge_on_review_cap`, deliberately STAYS at its safe
    // `false` default and is NOT listed here: a review that cannot converge
    // within `review_fix_cap` rounds is precisely the case that must reach a
    // human, per the design record cited in that section. A design-human-gated
    // (spec-change-tier) item still cannot auto-approve regardless of these.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      "auto_approve_ready": true,
      "wip_cap": 10,
      "acceptance_mode": "ai-only",
      "factories": {
        "hp": { "server": "https://hp-xubuntu.perch-rudd.ts.net:32276" },
        "vps": { "server": "https://vps.perch-rudd.ts.net:32276" }
      },
      "default_factory": "hp"
    }
  }
}
